<%= govuk_header(
      homepage_url: "https://www.education.gov.uk",
      classes: "app-header--#{HostingEnvironment.name} govuk-!-display-none-print",
      container_classes: "app-header__container"
    ) do |header| %>
  <% header.with_custom_logo do %>
    <%= image_tag "/images/dfe-logo-white.png", alt: "Department for Education", class: "govuk-header__logotype" %>
  <% end %>

  <% case current_namespace %>
  <% when "assessor", "support" %>
    <% if current_staff %>
      <%= govuk_link_to "Sign out", main_app.destroy_staff_session_path, inverse: true, class: "govuk-!-display-inline-block govuk-!-font-size-19 app-header__sign-out" %>
    <% end %>
  <% when "teacher" %>
    <% if current_teacher %>
      <% teacher_sign_out_path = FeatureFlags::FeatureFlag.active?(:gov_one_applicant_login) ? logout_uri : main_app.destroy_teacher_session_path %>
      <%= govuk_link_to "Sign out", teacher_sign_out_path, inverse: true, class: "govuk-!-display-inline-block govuk-!-font-size-19 app-header__sign-out" %>
    <% end %>
  <% end %>
<% end %>

<% sections = staff_navigation_sections %>
<% current_section = current_staff_navigation_section(sections) %>

<% service_url = current_namespace.in?(%w[assessor support]) ? "/assessor" : "/#{current_namespace}" %>

<%= govuk_service_navigation(classes: "govuk-!-display-none-print", service_name: t(current_namespace, scope: %i[service name]), service_url:) do |service_navigation| %>
  <% sections.each do |section| %>
    <% service_navigation.with_navigation_item(
        text: section[:text],
        href: section[:href] || section[:items].first[:href],
        active: section == current_section
      ) %>
  <% end %>
<% end %>

<% if current_section && current_section[:items].any? %>
  <%= govuk_service_navigation(classes: "govuk-!-display-none-print", navigation_id: "sub-navigation", html_attributes: { data: { module: nil } }) do |sub_navigation| %>
    <% current_section[:items].reject { |item| item[:new_tab] }.each do |item| %>
      <% sub_navigation.with_navigation_item(
           text: item[:text],
           href: item[:href],
           active: staff_navigation_item_active?(item)
         ) %>
    <% end %>

    <% if (new_tab_item = current_section[:items].find { |item| item[:new_tab] }) %>
      <% sub_navigation.with_navigation_end do %>
        <li class="govuk-service-navigation__item">
          <%= govuk_link_to new_tab_item[:text], new_tab_item[:href], class: "govuk-service-navigation__link", new_tab: true %>
        </li>
      <% end %>
    <% end %>
  <% end %>
<% end %>