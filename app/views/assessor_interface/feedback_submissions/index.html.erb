<% content_for :page_title, title_with_error_prefix("Service feedback", error: @view_object.filter_form.errors.any?) %>

<h1 class="govuk-heading-xl">Service feedback</h1>

<div class="app-application-forms__filters govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-m">Filters</h2>

  <%= form_with model: @view_object.filter_form, url: filters_apply_assessor_interface_feedback_submissions_path, method: :post do |f| %>
    <%= f.govuk_error_summary %>

    <%= f.govuk_fieldset legend: { text: "Date feedback submitted", size: "s" } do %>
      <div class="app-inline-content">
        <div class="govuk-!-margin-right-9">
          <%= f.govuk_date_field :submitted_at_after, legend: { text: "From", size: "s" } %>
        </div>

        <div>
          <%= f.govuk_date_field :submitted_at_before, legend: { text: "To", size: "s" } %>
        </div>
      </div>
    <% end %>

    <%= f.govuk_submit "Apply filters" do %>
      <a href="<%= filters_clear_assessor_interface_feedback_submissions_path %>" class="govuk-link">
        Clear selection
      </a>
    <% end %>
  <% end %>
</div>

<% if (records = @view_object.feedback_submissions_records).present? %>
  <%= govuk_button_link_to "Download feedback (CSV)", assessor_interface_feedback_submissions_exports_path, secondary: true %>

  <h2 class="govuk-heading-m">
    <%= pluralize(
      @view_object.feedback_submissions_pagy.count,
      "feedback result",
    ) %>
  </h2>

  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(header: true, text: "ID")
          row.with_cell(header: true, text: "Status")
          row.with_cell(header: true, text: "Rating")
          row.with_cell(header: true, text: "Comments")
          row.with_cell(header: true, text: "Submitted on")
        end
      end

      table.with_body do |body|
        records.each do |feedback_submission|
          body.with_row do |row|
            row.with_cell do
              govuk_link_to(
                feedback_submission.id.to_s.rjust(4, "0"),
                [:assessor_interface, feedback_submission],
              )
            end
            row.with_cell { feedback_submission.application_status&.humanize }
            row.with_cell { feedback_submission.overall_experience&.humanize }
            row.with_cell do
              simple_format(
                truncate(
                  feedback_submission.comment,
                  length: 151,
                  omission: "…",
                ),
              )
            end
            row.with_cell do
              if feedback_submission.submitted_at.present?
                safe_join(
                  [
                    feedback_submission.submitted_at.strftime("%d/%m/%Y"),
                    tag.br,
                    feedback_submission.submitted_at.strftime("%H:%M"),
                  ],
                )
              end
            end
          end
        end
      end
    end
  %>

  <%= govuk_pagination(pagy: @view_object.feedback_submissions_pagy) %>
<% else %>
  <h2 class="govuk-heading-m">No feedback found.</h2>
<% end %>
