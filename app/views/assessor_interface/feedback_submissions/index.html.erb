<% content_for :page_title, "Service feedback" %>

<h1 class="govuk-heading-xl">Service feedback</h1>

<% if (records = @view_object.feedback_submissions_records).present? %>
  <h2 class="govuk-heading-m"><%= @view_object.feedback_submissions_pagy.count %> feedback submissions</h2>

  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(header: true, text: "ID")
          row.with_cell(header: true, text: "Status")
          row.with_cell(header: true, text: "Rating")
          row.with_cell(header: true, text: "Comments")
          row.with_cell(header: true, text: "Submitted on")
        end
      end

      table.with_body do |body|
        records.each do |feedback_submission|
          body.with_row do |row|
            row.with_cell { feedback_submission.id.to_s.rjust(4, "0") }
            row.with_cell { feedback_submission.application_status&.humanize }
            row.with_cell { feedback_submission.overall_experience&.humanize }
            row.with_cell { simple_format(feedback_submission.comment) }
            row.with_cell do
              if feedback_submission.submitted_at.present?
                safe_join(
                  [
                    feedback_submission.submitted_at.strftime("%d/%m/%Y"),
                    tag.br,
                    feedback_submission.submitted_at.strftime("%H:%M"),
                  ],
                )
              end
            end
          end
        end
      end
    end
  %>

  <%= govuk_pagination(pagy: @view_object.feedback_submissions_pagy) %>
<% else %>
  <h2 class="govuk-heading-m">No feedback found.</h2>
<% end %>
