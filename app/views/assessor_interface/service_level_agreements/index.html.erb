<% content_for :page_title, "SLA status" %>

<h1 class="govuk-heading-xl govuk-!-margin-bottom-5">SLA status</h1>

<ul class="govuk-service-navigation__list govuk-!-margin-bottom-8">
  <li class="govuk-service-navigation__item <%= 'govuk-service-navigation__item--active' if current_page?(assessor_interface_service_level_agreements_path) %>">
    <%= link_to "Applications", assessor_interface_service_level_agreements_path, class: "govuk-service-navigation__link govuk-body" %>
  </li>
  <li class="govuk-service-navigation__item <%= 'govuk-service-navigation__item--active' if current_page?(totals_assessor_interface_service_level_agreements_path) %>">
    <%= link_to "Totals", totals_assessor_interface_service_level_agreements_path, class: "govuk-service-navigation__link govuk-body" %>
  </li>
</ul>

<div class="app-application-forms__filters govuk-!-margin-bottom-8">
  <h2 class="govuk-heading-m"><%= t(".filters.title") %></h2>

  <%= form_with model: @view_object.filter_form, url: filters_apply_assessor_interface_service_level_agreements_path, method: :post do |f| %>
    <%= f.hidden_field :sla, value: params[:sla] %>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-third">
        <section class="app-checkbox-filter app-checkbox-filter--enhanced">
          <div class="app-checkbox-filter__container">
            <div class="app-checkbox-filter__container-inner">
              <%= f.govuk_check_boxes_fieldset :breach_statuses, legend: { size: "s" }, small: true do %>
                <% @view_object.breach_statuses_options.each do |option| %>
                  <%= f.govuk_check_box :breach_statuses, option.id, label: { text: option.name }, checked: @view_object.filter_form.breach_statuses&.include?(option.id.to_s) %>
                <% end %>
              <% end %>
            </div>
          </div>
        </section>
      </div>

      <div class="govuk-grid-column-one-third">
        <section class="app-checkbox-filter app-checkbox-filter--enhanced">
          <div class="app-checkbox-filter__container">
            <div class="app-checkbox-filter__container-inner">
              <%= f.govuk_check_boxes_fieldset :country_groupings, legend: { size: "s" }, small: true do %>
                <% @view_object.country_groupings_options.each do |option| %>
                  <%= f.govuk_check_box :country_groupings, option.id, label: { text: option.name }, checked: @view_object.filter_form.country_groupings&.include?(option.id.to_s) %>
                <% end %>
              <% end %>
            </div>
          </div>
        </section>
      </div>

      <div class="govuk-grid-column-one-third">
        <section>
          <%= f.govuk_check_boxes_fieldset :prioritised, legend: nil, multiple: false, small: true do %>
            <%= f.govuk_check_box :prioritised, :true, multiple: false, label: { text: "Show only prioritised applications" }, checked: @view_object.filter_form.prioritised == "true" %>
          <% end %>
        </section>
      </div>
    </div>

    <%= f.govuk_submit t(".filters.apply") do %>
      <a href="<%= filters_clear_assessor_interface_service_level_agreements_path %>" class="govuk-link">
        <%= t(".filters.clear") %>
        <%= govuk_visually_hidden(t(".filters.of_filter")) %>
      </a>
    <% end %>
  <% end %>
</div>

<div class="govuk-tabs" data-module="govuk-tabs">
  <h2 class="govuk-tabs__title">
    Contents
  </h2>
  <ul class="govuk-tabs__list">
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:sla].blank? %>">
      <%= link_to "10 day", assessor_interface_service_level_agreements_path %>
    </li>
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:sla] == "40" %>">
      <%= link_to "40 day", assessor_interface_service_level_agreements_path(sla: "40") %>
    </li>
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:sla] == "80" %>">
      <%= link_to "80 day", assessor_interface_service_level_agreements_path(sla: "80") %>
    </li>
  </ul>

  <div class="govuk-tabs__panel">
    <% if (records = @view_object.application_forms_records).present? %>
      <h2 class="govuk-heading-m"><%= @view_object.application_forms_pagy.count %> application forms</h2>
      <%=
        govuk_table(classes: "application-forms-sla") do |table|
          table.with_head do |head|
            head.with_row do |row|
              row.with_cell(header: true, text: "Reference")
              row.with_cell(header: true, text: "Country/Region")
              row.with_cell(header: true, text: "Working days since submission")
              row.with_cell(header: true, text: "Status")
            end
          end

          table.with_body do |body|
            records.each do |application_form|
              body.with_row do |row|
                row.with_cell { govuk_link_to application_form.reference, [:assessor_interface, application_form] }
                row.with_cell { CountryName.from_region(application_form.region) }
                row.with_cell do
                  govuk_tag(text: application_form.working_days_between_submitted_and_today, colour: @view_object.sla_working_day_tag_colour(application_form) )
                end
                row.with_cell do
                  render(
                    StatusTag::Component.new(
                      application_form.statuses
                    ),
                  )
                end
              end
            end
          end
        end
      %>
      <%= govuk_pagination(pagy: @view_object.application_forms_pagy) %>
    <% else %>
      <h2 class="govuk-heading-m"><%= t(".results.empty") %></h2>
    <% end %>
  </div>
</div>

