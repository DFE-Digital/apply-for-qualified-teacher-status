<%= render "header_with_nav" %>

<%= govuk_details(summary_text: "SLA definitions") do %>
  <p class="govuk-body">The service level agreements (SLA) are targets for how long it should take to assess applications.</p>

  <h2 class="govuk-heading-s govuk-!-margin-bottom-0">10 day SLA</h2>
  <p class="govuk-body">Prioritisation checks must be started within 10 working days of the application being submitted. "Nearing" is shown 8 working days after submission.</p>

  <h2 class="govuk-heading-s govuk-!-margin-bottom-0">40 day SLA</h2>
  <p class="govuk-body">Initial assessment must be completed within 40 working days of the application being submitted. "Nearing" is shown 35 working days after submission.</p>

  <h2 class="govuk-heading-s govuk-!-margin-bottom-0">80 day SLA</h2>
  <p class="govuk-body">All applications must have an outcome within 80 working days of the application being submitted. "Nearing" is shown 65 working days after submission.</p>
<% end %>

<div class="govuk-tabs" data-module="govuk-tabs">
  <h2 class="govuk-tabs__title">
    Contents
  </h2>
  <ul class="govuk-tabs__list">
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:country_groupings].blank? %>">
      <%= link_to "Total applications", totals_assessor_interface_service_level_agreements_path %>
    </li>
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:country_groupings] == "uk_and_gibraltar" %>">
      <%= link_to "UK & Gibraltar", totals_assessor_interface_service_level_agreements_path(country_groupings: "uk_and_gibraltar") %>
    </li>
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:country_groupings] == "eu" %>">
      <%= link_to "EU", totals_assessor_interface_service_level_agreements_path(country_groupings: "eu") %>
    </li>
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:country_groupings] == "efta" %>">
      <%= link_to "EFTA", totals_assessor_interface_service_level_agreements_path(country_groupings: "efta") %>
    </li>
    <li class="govuk-tabs__list-item <%= 'govuk-tabs__list-item--selected' if params[:country_groupings] == "rest_of_world" %>">
      <%= link_to "Rest of the world", totals_assessor_interface_service_level_agreements_path(country_groupings: "rest_of_world") %>
    </li>
  </ul>

  <div class="govuk-tabs__panel">
    <%=
      govuk_table do |table|
        table.with_head do |head|
          head.with_row do |row|
            row.with_cell(header: true, text: "")
            row.with_cell(header: true, text: "Nearing")
            row.with_cell(header: true, text: "Breached")
          end
        end

        table.with_body do |body|
          @view_object.sla_counts.each do |sla, counts|
            body.with_row do |row|
              row.with_cell(header: true, text: "#{sla} day")
              row.with_cell { counts[:nearing].to_s }
              row.with_cell { counts[:breached].to_s }
            end
          end
        end
      end
    %>
  </div>
</div>
